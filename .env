# URL del gateway de ParkLink (ver ../compose.yaml en la raíz, servicio "gateway").
# Expo SDK 57 carga automáticamente las variables EXPO_PUBLIC_* de este archivo
# (via `npx expo start`), embebidas en el bundle -- no son secretas, no pongas
# acá ninguna credencial.
#
# - Web / iOS simulator: localhost funciona tal cual.
# - Emulador Android: usá http://10.0.2.2:8080 (localhost del emulador apunta
#   al emulador mismo, no a tu máquina).
# - Dispositivo físico: usá la IP LAN de la máquina que corre `docker compose`
#   (ej. http://192.168.1.50:8080), con el celular en la misma red.
EXPO_PUBLIC_API_URL=https://parklink-gateway.onrender.com

# El auth-service de este deploy no tiene Twilio configurado (SKIP_PHONE_VERIFICATION=true
# en render.yaml) -- sin esto, el wizard de registro pediría un código SMS que nunca llega.
EXPO_PUBLIC_SKIP_PHONE_VERIFICATION=true
