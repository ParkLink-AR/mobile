# Suppress npm audit during install. All remaining advisories require
# downgrading expo from SDK 57 to SDK 46 — which is not a real fix.
# Run `npm audit` manually if you need to review them.
fund=false
audit=false
# @react-native-community/datetimepicker lists react-native-windows as an optional peer; its
# latest version asks for an older react-native than SDK 58's, and npm refuses the install
# over it even though it's never installed. Peer versions are Expo's to align (expo install).
legacy-peer-deps=true
